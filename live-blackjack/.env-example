# copia questo file in .env e adatta i valori
# .env contiene segreti: non va mai committato (.gitignore lo esclude)

# chiave usata per firmare i cookie di sessione, genera una stringa a caso
SECRET_KEY=genera-una-stringa-segreta

# stringa di connessione al database
# di default si usa il file sqlite instance/blackjack.db
SQLALCHEMY_DATABASE_URI=sqlite:///blackjack.db
